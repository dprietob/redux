<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.8"/>
  <template class="ReduxWindow" parent="AdwApplicationWindow">
    <property name="title">Redux</property>
    <property name="default-width">1000</property>
    <property name="default-height">680</property>
    <!-- Smallest size GNOME supports on phones. -->
    <property name="width-request">360</property>
    <property name="height-request">294</property>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwNavigationSplitView" id="split_view">
            <property name="min-sidebar-width">320</property>
            <property name="max-sidebar-width">480</property>
            <property name="sidebar-width-fraction">0.42</property>
          </object>
        </property>
      </object>
    </property>
    <!-- On narrow screens the image list and the conversion options become
         two pages: the list first, the options one tap away. -->
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 720sp</condition>
        <setter object="split_view" property="collapsed">True</setter>
      </object>
    </child>
  </template>
</interface>
