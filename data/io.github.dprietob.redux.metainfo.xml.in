<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.dprietob.redux</id>

  <name>Redux</name>
  <summary translatable="yes">Convert, compress and resize images</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="com.dprietob">
    <name translatable="no">Daniel Prieto</name>
  </developer>

  <description>
    <p translatable="yes">
      Redux is a simple and fast batch image converter.
    </p>
    <p translatable="yes">
      Pick a set of images, choose the output format, quality and
      size, and convert them all at once. When it finishes, Redux shows how much
      space you saved.
    </p>
    <p translatable="yes">Features:</p>
    <ul>
      <li translatable="yes">Convert images to WebP, JPEG and PNG.</li>
      <li translatable="yes">Adjust the quality of WebP and JPEG images and the compression level of PNG images.</li>
      <li translatable="yes">Resize images in pixels or by percentage, keeping the aspect ratio or not.</li>
      <li translatable="yes">Rename the converted images with a pattern.</li>
      <li translatable="yes">Keep or remove the metadata of every image.</li>
      <li translatable="yes">See a report with the size reduction of every image.</li>
      <li translatable="yes">Light and dark styles.</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.dprietob.redux.desktop</launchable>

  <url type="homepage">https://github.com/dprietob/redux</url>
  <url type="bugtracker">https://github.com/dprietob/redux/issues</url>
  <url type="vcs-browser">https://github.com/dprietob/redux</url>

  <screenshots>
    <screenshot type="default">
      <caption translatable="yes">Choose the output format, quality, size, file names and metadata</caption>
      <image>https://raw.githubusercontent.com/dprietob/redux/master/screenshots/01_main.png</image>
    </screenshot>
    <screenshot>
      <caption translatable="yes">Pick the images to convert</caption>
      <image>https://raw.githubusercontent.com/dprietob/redux/master/screenshots/02_images_list.png</image>
    </screenshot>
    <screenshot>
      <caption translatable="yes">Rename the converted images with a pattern</caption>
      <image>https://raw.githubusercontent.com/dprietob/redux/master/screenshots/03_renaming_options.png</image>
    </screenshot>
    <screenshot>
      <caption translatable="yes">Choose the metadata each image keeps</caption>
      <image>https://raw.githubusercontent.com/dprietob/redux/master/screenshots/04_metadata.png</image>
    </screenshot>
    <screenshot>
      <caption translatable="yes">See how much space you saved</caption>
      <image>https://raw.githubusercontent.com/dprietob/redux/master/screenshots/05_conversion_results_1.png</image>
    </screenshot>
    <screenshot>
      <caption translatable="yes">Review the result of every image</caption>
      <image>https://raw.githubusercontent.com/dprietob/redux/master/screenshots/06_conversion_results_2.png</image>
    </screenshot>
    <screenshot>
      <caption translatable="yes">Light style</caption>
      <image>https://raw.githubusercontent.com/dprietob/redux/master/screenshots/07_main_light.png</image>
    </screenshot>
    <screenshot>
      <caption translatable="yes">Image list in the light style</caption>
      <image>https://raw.githubusercontent.com/dprietob/redux/master/screenshots/08_images_list_light.png</image>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#ff9900</color>
    <color type="primary" scheme_preference="dark">#d4ff00</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-11-20" type="development">
      <description>
        <p translatable="yes">Initial release.</p>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1" />

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
</component>
