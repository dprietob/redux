#: data/io.github.dprietob.redux.desktop.in:2
#: data/io.github.dprietob.redux.metainfo.xml.in:5
msgid "Redux"
msgstr "Redux"

#: data/io.github.dprietob.redux.desktop.in:3
msgid "Image Converter"
msgstr "Conversor de imágenes"

#: data/io.github.dprietob.redux.desktop.in:4
#: data/io.github.dprietob.redux.metainfo.xml.in:6
msgid "Convert, compress and resize images"
msgstr "Convierte, comprime y redimensiona imágenes"

#: data/io.github.dprietob.redux.desktop.in:10
msgid "image;picture;photo;convert;compress;resize;webp;jpeg;png;"
msgstr "imagen;foto;fotografía;convertir;comprimir;redimensionar;webp;jpeg;png;"

#: data/io.github.dprietob.redux.metainfo.xml.in:12
msgid "Daniel Prieto"
msgstr "Daniel Prieto"

#: data/io.github.dprietob.redux.metainfo.xml.in:16
msgid "Redux is a simple, fast batch image converter."
msgstr "Redux es un conversor de imágenes por lotes sencillo y rápido."

#: data/io.github.dprietob.redux.metainfo.xml.in:19
msgid "Pick a set of images, choose the output format, quality and size, and convert them all at once. When it finishes, Redux shows how much space you saved."
msgstr "Elige un conjunto de imágenes, selecciona el formato de salida, la calidad y el tamaño, y conviértelas todas a la vez. Al terminar, Redux muestra cuánto espacio has ahorrado."

#: data/io.github.dprietob.redux.metainfo.xml.in:24
msgid "Features:"
msgstr "Características:"

#: data/io.github.dprietob.redux.metainfo.xml.in:26
msgid "Convert images to WebP, JPEG and PNG."
msgstr "Convierte imágenes a WebP, JPEG y PNG."

#: data/io.github.dprietob.redux.metainfo.xml.in:27
msgid "Adjust the quality of WebP and JPEG images and the compression level of PNG images."
msgstr "Ajusta la calidad de las imágenes WebP y JPEG y el nivel de compresión de las imágenes PNG."

#: data/io.github.dprietob.redux.metainfo.xml.in:28
msgid "Resize images in pixels or by percentage, keeping the aspect ratio or not."
msgstr "Redimensiona imágenes en píxeles o por porcentaje, manteniendo o no la relación de aspecto."

#: data/io.github.dprietob.redux.metainfo.xml.in:29
msgid "Rename the converted images with a pattern."
msgstr "Renombra las imágenes convertidas con un patrón."

#: data/io.github.dprietob.redux.metainfo.xml.in:30
msgid "Keep or remove the metadata of every image."
msgstr "Conserva o elimina los metadatos de cada imagen."

#: data/io.github.dprietob.redux.metainfo.xml.in:31
msgid "See a report with the size reduction of every image."
msgstr "Consulta un informe con la reducción de tamaño de cada imagen."

#: data/io.github.dprietob.redux.metainfo.xml.in:32
msgid "Light and dark styles."
msgstr "Estilos claro y oscuro."

#: data/io.github.dprietob.redux.metainfo.xml.in:44
msgid "Choose the output format, quality, size, file names and metadata"
msgstr "Elige el formato de salida, la calidad, el tamaño, los nombres de fichero y los metadatos"

#: data/io.github.dprietob.redux.metainfo.xml.in:48
msgid "Pick the images to convert"
msgstr "Elige las imágenes que quieres convertir"

#: data/io.github.dprietob.redux.metainfo.xml.in:52
msgid "Rename the converted images with a pattern"
msgstr "Renombra las imágenes convertidas con un patrón"

#: data/io.github.dprietob.redux.metainfo.xml.in:56
msgid "Choose the metadata each image keeps"
msgstr "Elige qué metadatos conserva cada imagen"

#: data/io.github.dprietob.redux.metainfo.xml.in:60
msgid "See how much space you saved"
msgstr "Consulta cuánto espacio has ahorrado"

#: data/io.github.dprietob.redux.metainfo.xml.in:64
msgid "Review the result of every image"
msgstr "Revisa el resultado de cada imagen"

#: data/io.github.dprietob.redux.metainfo.xml.in:68
msgid "Light style"
msgstr "Estilo claro"

#: data/io.github.dprietob.redux.metainfo.xml.in:72
msgid "Image list in the light style"
msgstr "Lista de imágenes con el estilo claro"

#: data/io.github.dprietob.redux.metainfo.xml.in:85
msgid "Initial release."
msgstr "Versión inicial."
