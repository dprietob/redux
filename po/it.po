msgstr "Larghezza e altezza non devono superare %d pixel."

#: src/modules/Conversion/validators/ConversionValidator.vala:58
#, c-format
msgid "The percentages must be between %d and %d."
msgstr "Le percentuali devono essere comprese tra %d e %d."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:34
msgid "Enter a pattern for the new names."
msgstr "Inserire uno schema per i nuovi nomi."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:36
msgid "The pattern has an unknown placeholder. Use {name}, {number}, {date} or {time}."
msgstr "Lo schema contiene un segnaposto sconosciuto. Usare {name}, {number}, {date} o {time}."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:37
msgid "The pattern cannot contain “/”."
msgstr "Lo schema non può contenere «/»."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:38
msgid "The prefix cannot contain “/”."
msgstr "Il prefisso non può contenere «/»."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:39
msgid "The suffix cannot contain “/”."
msgstr "Il suffisso non può contenere «/»."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:40
#, c-format
msgid "The first number must be between 0 and %d."
msgstr "Il primo numero deve essere compreso tra 0 e %d."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:42
#, c-format
msgid "The number of digits must be between %d and %d."
msgstr "Il numero di cifre deve essere compreso tra %d e %d."

