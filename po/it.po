msgstr "Il livello di compressione deve essere compreso tra %d e %d."

#: src/modules/Conversion/validators/ConversionValidator.vala:54
msgid "Enter a width, a height or both."
msgstr "Inserire una larghezza, un'altezza o entrambe."

#: src/modules/Conversion/validators/ConversionValidator.vala:55
