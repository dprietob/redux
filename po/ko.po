msgstr "새 이름의 패턴을 입력하십시오."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:36
msgid "The pattern has an unknown placeholder. Use {name}, {number}, {date} or {time}."
msgstr "패턴에 알 수 없는 자리 표시자가 있습니다. {name}, {number}, {date}, {time}을(를) 사용하십시오."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:37
msgid "The pattern cannot contain “/”."
msgstr "패턴에 “/”를 넣을 수 없습니다."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:38
msgid "The prefix cannot contain “/”."
msgstr "접두어에 “/”를 넣을 수 없습니다."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:39
msgid "The suffix cannot contain “/”."
msgstr "접미어에 “/”를 넣을 수 없습니다."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:40
#, c-format
msgid "The first number must be between 0 and %d."
msgstr "시작 번호는 0에서 %d 사이여야 합니다."

#: src/modules/Conversion/validators/FileNamePatternValidator.vala:42
#, c-format
msgid "The number of digits must be between %d and %d."
msgstr "자릿수는 %d에서 %d 사이여야 합니다."

