<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.8"/>
  <template class="ReduxConversionConversionResultRow" parent="AdwActionRow">
    <property name="use-markup">false</property>
    <property name="title-lines">1</property>
    <property name="subtitle-lines">3</property>
    <child type="prefix">
      <object class="GtkImage" id="status_icon">
        <property name="valign">center</property>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkLabel" id="reduction_label">
        <property name="valign">center</property>
        <style>
          <class name="numeric"/>
        </style>
      </object>
    </child>
  </template>
</interface>
